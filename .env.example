# JWT secret for authentication
JWT_SECRET="your-jwt-secret-key-here"

# Stripe payment integration
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
FRONTEND_URL="https://wickandwax.app"

# Email service
EMAIL_FROM="Wick & Wax <no-reply@wickandwax.app>"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your_smtp_user"
SMTP_PASS="your_smtp_password"

# CORS
ALLOWED_ORIGINS="https://wickandwax.app,http://localhost:3000,http://localhost:5173"

# OpenRouter AI for Co-Pilot
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="google/gemini-2.0-flash-001"
OPENROUTER_REFERER="https://wickandwax.app"
GEMINI_API_KEY="your-gemini-api-key-here"

# Server configuration
PORT=3000
NODE_ENV=development
